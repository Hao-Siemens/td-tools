{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "lorav": "https://www.w3.org/2024/wot/lorawan#",
      "schema": "https://schema.org/",
      "brick": "https://brickschema.org/schema/Brick#"
    }
  ],
  "@type": ["Thing", "brick:Leak_Detector_Equipment", "brick:Temperature_Sensor", "brick:Relative_Humidity_Sensor"],
  "id": "urn:dev:milesight_em300_zld",
  "title": "milesight em300 zld",
  "description": "Milesight EM300-ZLD leak detection sensor with battery, temperature, humidity, and leak status uplink events.",
  "securityDefinitions": {
    "otaa_sc": {
      "scheme": "apikey",
      "in": "uri",
      "name": "appKey",
      "description": "LoRaWAN OTAA AppKey (root key). Injected at runtime by the Servient; never stored in this TD."
    }
  },
  "security": "otaa_sc",
  "base": "lorawan://0000000000000000/{appKey}/device",
  "lorav:devEUI": "0000000000000000",
  "lorav:joinEUI": "0000000000000000",
  "lorav:macVersion": "1.0.2",
  "schema:manufacturer": "Milesight",
  "schema:mpn": "EM300-ZLD",
  "schema:version": "1",
  "schema:softwareVersion": "1",
  "lorav:region": "EU868",
  "lorav:frequencyPlan": "EU_863_870",
  "lorav:payloadLayout": "tlv",
  "lorav:tagFields": [
    {
      "name": "channel_id",
      "type": "u8"
    },
    {
      "name": "channel_type",
      "type": "u8"
    }
  ],
  "defaultEventingFrequencyMinutes": 10,
  "events": {
    "battery": {
      "data": {
        "type": "integer",
        "unit": "%",
        "readOnly": true
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:tag": [
            1,
            117
          ],
          "lorav:wireType": "u8"
        }
      ]
    },
    "temperature": {
      "@type": "brick:Temperature_Sensor",
      "knxDatapointType": "9.001",
      "data": {
        "type": "number",
        "unit": "Cel",
        "readOnly": true
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:tag": [
            3,
            103
          ],
          "lorav:wireType": "s16",
          "lorav:endian": "little",
          "lorav:divisor": 10
        }
      ]
    },
    "humidity": {
      "@type": "brick:Relative_Humidity_Sensor",
      "knxDatapointType": "9.007",
      "data": {
        "type": "number",
        "unit": "%RH",
        "readOnly": true
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:tag": [
            4,
            104
          ],
          "lorav:wireType": "u8",
          "lorav:divisor": 2
        }
      ]
    },
    "leakage_status": {
      "@type": "brick:Leak_Detector_Equipment",
      "data": {
        "type": "string",
        "enum": [
          "normal",
          "leak"
        ],
        "readOnly": true
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:tag": [
            5,
            0
          ],
          "lorav:wireType": "u8",
          "lorav:valueMap": [
            {
              "wireValue": 0,
              "value": "normal"
            },
            {
              "wireValue": 1,
              "value": "leak"
            }
          ]
        }
      ]
    }
  }
}
