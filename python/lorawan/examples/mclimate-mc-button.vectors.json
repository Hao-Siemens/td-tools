{
  "td": "mclimate-mc-button.td.json",
  "description": "MClimate Multipurpose Button keepalive vectors based on the official TTN codec: battery scaling, thermistor-connectivity bit mapped through lorav:valueMap, 10-bit temperature, and press event code.",
  "vectors": [
    {
      "name": "single_press_connected",
      "payload": "016400F801",
      "expected": {
        "frameType": 1,
