        "sensorTemperature": 24.8,
        "pressEvent": 1
      }
    },
    {
      "name": "double_press_disconnected",
      "payload": "017D04F402",
      "expected": {
        "frameType": 1,
        "batteryVoltage": 2.6,
        "thermistorProperlyConnected": "disconnected",
        "sensorTemperature": 24.4,
        "pressEvent": 2
      }
    },
    {
      "name": "triple_press_zero_temp",
      "payload": "0132000003",
      "expected": {
        "frameType": 1,
        "batteryVoltage": 2.0,
        "thermistorProperlyConnected": "connected",
        "sensorTemperature": 0.0,
        "pressEvent": 3
      }
    },
    {
      "name": "triple_press_temp",
      "payload": "01AB029B03",
      "expected": {
        "frameType": 1,
