{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "lorav": "https://www.w3.org/2024/wot/lorawan#",
      "schema": "https://schema.org/"
    }
  ],
  "@type": "Thing",
  "id": "urn:dev:adeunis_comfort2",
  "title": "adeunis comfort2",
  "description": "Adeunis Comfort 2 basic sensor-reading mapping for the official 0x4C data frame (temperature/humidity history): first sample only.",
  "securityDefinitions": {
    "otaa_sc": {
      "scheme": "apikey",
      "in": "uri",
      "name": "appKey",
      "description": "LoRaWAN OTAA AppKey (root key). Injected at runtime by the Servient; never stored in this TD."
    }
  },
  "security": "otaa_sc",
  "base": "lorawan://0000000000000000/{appKey}/device",
  "lorav:devEUI": "0000000000000000",
  "lorav:joinEUI": "0000000000000000",
  "lorav:macVersion": "1.0.2",
  "schema:brand": "Adeunis",
  "schema:model": "Comfort 2",
  "lorav:region": "EU868",
  "lorav:frequencyPlan": "EU_863_870_TTN",
  "lorav:payloadLayout": "fixed",
  "events": {
    "frameCode": {
      "data": {
        "type": "integer"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:byteOffset": 0,
          "lorav:wireType": "u8"
        }
      ]
    },
    "statusByte": {
      "data": {
        "type": "integer"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:byteOffset": 1,
          "lorav:wireType": "u8"
        }
      ]
    },
    "temperature": {
      "data": {
        "type": "number",
        "unit": "°C"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:byteOffset": 2,
          "lorav:wireType": "s16",
          "lorav:divisor": 10
        }
      ]
    },
    "humidity": {
      "data": {
        "type": "integer",
        "unit": "%"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:byteOffset": 4,
          "lorav:wireType": "u8"
        }
      ]
    }
  },
  "version": {
    "model": "1",
    "instance": "1"
  }
}
