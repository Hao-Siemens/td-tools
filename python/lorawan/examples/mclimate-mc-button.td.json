{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "lorav": "https://www.w3.org/2024/wot/lorawan#",
      "schema": "https://schema.org/",
      "brick": "https://brickschema.org/schema/Brick#"
    }
  ],
  "@type": ["Thing", "brick:Temperature_Sensor"],
  "id": "urn:dev:mclimate:mc-button",
  "title": "mclimate_mc_button",
  "description": "MClimate Multipurpose Button LoRaWAN",
  "securityDefinitions": {
    "otaa_sc": {
      "scheme": "apikey",
      "in": "uri",
      "name": "appKey",
      "description": "LoRaWAN OTAA AppKey (root key). Injected at runtime by the Servient; never stored in this TD."
    }
  },
  "security": "otaa_sc",
  "base": "lorawan://0000000000000001/{appKey}/device",
  "lorav:devEUI": "0000000000000001",
  "lorav:joinEUI": "0000000000000000",
  "lorav:macVersion": "1.0.3",
  "schema:manufacturer": "MClimate",
  "schema:mpn": "MC Button",
  "schema:version": "1.0",
  "schema:softwareVersion": "1.0",
  "lorav:region": "EU868",
  "lorav:frequencyPlan": "EU_863_870",
  "lorav:payloadLayout": "fixed",
  "defaultEventingFrequencyMinutes": 10,
  "events": {
    "frameType": {
      "description": "Byte 0 frame discriminator. 1 indicates a keepalive frame in the official decoder.",
      "data": {
        "type": "integer",
        "readOnly": true
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:byteOffset": 0,
          "lorav:wireType": "xsd:unsignedByte"
        }
      ]
    },
    "batteryVoltage": {
      "description": "Battery voltage in volts using direct raw scaling from byte 1: V=(byte*8+1600)/1000.",
      "data": {
        "type": "number",
        "unit": "V",
        "readOnly": true
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:byteOffset": 1,
          "lorav:wireType": "xsd:unsignedByte",
          "lorav:multiplier": 0.008,
          "lorav:addend": 1.6
        }
      ]
    },
    "thermistorProperlyConnected": {
      "description": "Thermistor status from byte 2, bit 2. The bit is set when the thermistor is absent..",
      "data": {
        "type": "boolean",
        "readOnly": true
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:byteOffset": 2,
          "lorav:wireType": "xsd:unsignedByte",
          "lorav:bitmask": "0x04",
          "lorav:valueMap": [
            {
              "wireValue": 0,
              "value": true
            },
            {
              "wireValue": 1,
              "value": false
            }
          ]
        }
      ]
    },
    "sensorTemperature": {
      "@type": "brick:Temperature_Sensor",
      "knxDatapointType": "9.001",
      "description": "Thermistor temperature in Celsius from byte 3 using the official 0.1C scaling. ",
      "data": {
        "type": "number",
        "unit": "Cel",
        "readOnly": true
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:byteOffset": 3,
          "lorav:wireType": "xsd:unsignedByte",
          "lorav:divisor": 10
        }
      ]
    },
    "pressEvent": {
      "description": "Button press code from byte 4 (1=single, 2=double, 3=triple). ",
      "data": {
        "type": "integer",
        "readOnly": true
      },
      "forms": [
        {
          "href": "uplink",
          "op": [
            "subscribeevent",
            "unsubscribeevent"
          ],
          "lorav:byteOffset": 4,
          "lorav:wireType": "xsd:unsignedByte"
        }
      ]
    }
  }
}