# Python
__pycache__/
*.py[cod]
.python-version

# uv / virtualenv
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editor
.vscode/

# Build artifacts
dist/
build/
*.egg-info/

# Temporary local scratch scripts
/_tmp_*.py

# The curated `examples/*.td.json` + `*.vectors.json` pairs are checked in: this
# repository is the reference for them, so they are reviewed like any other source.

# Generated codec artifacts (reproducible via `lorawan-wot convert` / generators)
# Folder skeletons are tracked via .gitkeep; only their contents are ignored.
examples/generated/*
!examples/generated/.gitkeep
examples/devices/*
!examples/devices/.gitkeep
